{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gart.common/0",
  "description": "$defs que reutiliza cualquier esquema: ContentHash, ArtifactRef, License, Timestamp y Meta. Se usan con $ref \"gart.common/0#/$defs/<nombre>\".",
  "$defs": {
    "ContentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ArtifactRef": {
      "description": "Apunta a un artefacto o a un archivo por su hash; solo un artefacto lleva kind.",
      "type": "object",
      "additionalProperties": false,
      "required": ["hash"],
      "properties": {
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9]*\\.[a-z][a-z0-9_.]*/(0|[1-9][0-9]*)$"},
        "hash": {"$ref": "#/$defs/ContentHash"}
      }
    },
    "License": {
      "description": "Identificador tipo SPDX o LicenseRef-*, y autor. La lista SPDX real es la inv. 13 (pendiente).",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "author"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]*$|^LicenseRef-[A-Za-z0-9.-]+$"},
        "author": {"type": "string", "minLength": 1}
      }
    },
    "Timestamp": {
      "description": "UTC, ISO 8601, terminado en Z.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z$"
    },
    "Meta": {"type": "object"}
  }
}
